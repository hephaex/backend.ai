FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc python3-dev libpq-dev postgresql-client curl git \
    && rm -rf /var/lib/apt/lists/*

# etcdctl v3 for init job use (static binary)
RUN ETCD_VER=v3.5.13 && \
    curl -fsSL "https://github.com/etcd-io/etcd/releases/download/${ETCD_VER}/etcd-${ETCD_VER}-linux-amd64.tar.gz" \
      | tar xz --strip-components=1 -C /usr/local/bin "etcd-${ETCD_VER}-linux-amd64/etcdctl" && \
    chmod +x /usr/local/bin/etcdctl

# Copy and install Backend.AI manager from source
# Build context must be the repo root: docker build -f deploy/virtualon-k3s/manager/Dockerfile.manager .
WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml .
COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps .
# VERSION symlink breaks during pip install — write file directly into site-packages
RUN python -c "\
import pathlib, ai.backend.manager as m; \
p = pathlib.Path(m.__file__).parent / 'VERSION'; \
p.write_text(open('/build/VERSION').read())"

RUN useradd -m -u 1000 bai
RUN mkdir -p /var/run/backend.ai && chown -R bai:bai /var/run/backend.ai

WORKDIR /var/run/backend.ai

USER 1000
EXPOSE 8081
